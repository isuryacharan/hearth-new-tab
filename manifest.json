{
  "manifest_version": 3,
  "name": "Hearth",
  "version": "1.0.0",
  "description": "A calm, keyboard-first home for every new tab: command palette, bookmarks, to-dos, read later and more.",
  "permissions": ["bookmarks", "favicon", "storage", "alarms", "notifications", "search", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
